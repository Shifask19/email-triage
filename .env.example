# ============================================================
# Email Triage OpenEnv — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
#
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# MANDATORY — inference will exit(1) if HF_TOKEN is missing
# ------------------------------------------------------------

# Your HuggingFace API key (get it from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# MANDATORY — LLM endpoint and model
# ------------------------------------------------------------

# The API endpoint for the LLM (OpenAI-compatible)
# HuggingFace router (default):
API_BASE_URL=https://router.huggingface.co/v1

# Alternative endpoints:
# OpenAI:        https://api.openai.com/v1
# Together AI:   https://api.together.xyz/v1
# Fireworks:     https://api.fireworks.ai/inference/v1
# Local (vLLM):  http://localhost:8000/v1

# The model identifier to use for inference
# HuggingFace router models:
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Alternative models:
# MODEL_NAME=meta-llama/Llama-3.1-70B-Instruct
# MODEL_NAME=mistralai/Mixtral-8x7B-Instruct-v0.1
# MODEL_NAME=gpt-4o                          (OpenAI)
# MODEL_NAME=gpt-4o-mini                     (OpenAI)

# ------------------------------------------------------------
# OPTIONAL — server config
# ------------------------------------------------------------

# Port for the FastAPI server (HF Spaces requires 7860)
PORT=7860
